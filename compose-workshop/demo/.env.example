# Copy to .env (gitignored) and adjust. Compose reads .env automatically and
# fills the ${VAR} placeholders in compose.yaml; without the file, the
# ${VAR:-default} fallbacks apply.
POSTGRES_PASSWORD=workshop   # Postgres reads this into an EMPTY volume only: change it -> `down -v`
API_PORT=8000                # host port for the api — handy when 8000 is taken
